# Dev defaults only. Copy to .env if you want to override docker compose.
# Do not put real secrets in this file; it is committed on purpose.

POSTGRES_USER=orderflow
POSTGRES_PASSWORD=orderflow
POSTGRES_DB=postgres

MONGO_INITDB_DATABASE=orderflow

# Host ports published by docker compose.
GATEWAY_PORT=8080
ORDER_PORT=8081
INVENTORY_HTTP_PORT=8082
INVENTORY_GRPC_PORT=9090
PAYMENT_PORT=8083
QUERY_PORT=8084
POSTGRES_PORT=5432
MONGO_PORT=27017
KAFKA_HOST_PORT=29092
PROMETHEUS_PORT=9095
